---
// One route for every calculator: /<slug>-cost/. A calculator appears here once it is
// marked live in data/calculators.json and has a recipe, prices and a guide.
import { getEntry } from 'astro:content';
import { marked } from 'marked';
import Base from '../layouts/Base.astro';
import Calculator from '../components/Calculator.astro';
import AdSlot from '../components/AdSlot.astro';
import RelatedCalculators from '../components/RelatedCalculators.astro';
import { calculatorPath, dataProvenance, getBundle, liveSlugs, nationalArea } from '../lib/data';
import { site } from '../config/site';

export function getStaticPaths() {
  return liveSlugs().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const guide = await getEntry('guides', slug);
if (!guide) throw new Error(`Missing guide: src/content/guides/${slug}.md`);
const bundle = getBundle(slug);
const provenance = dataProvenance(slug);
const year = provenance.lastUpdated.slice(0, 4);
const g = guide.data;
const title = g.seo_title.replace('{year}', year);
const url = new URL(calculatorPath(slug), site.url).href;

// The guide is split at "<!-- ad -->" so an ad can sit mid-guide.
const [guideTop, guideBottom = ''] = (guide.body ?? '').split('<!-- ad -->').map((part) => marked.parse(part) as string);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: `${bundle.recipe.name} Cost Calculator`,
    url,
    description: g.meta_description,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: { '@type': 'Organization', name: site.name, url: site.url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: g.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url + '/' },
      { '@type': 'ListItem', position: 2, name: `${bundle.recipe.name} cost`, item: url },
    ],
  },
];
---

<Base title={title} description={g.meta_description} ogImage={slug} jsonLd={jsonLd}>
  <div class="container-page pt-6 sm:pt-10">
    <nav aria-label="Breadcrumb" class="mb-3 text-sm text-ink-soft">
      <a href="/" class="text-ink-soft">Home</a> <span aria-hidden="true">/</span> <span>{bundle.recipe.name} cost</span>
    </nav>
    <h1 class="text-3xl sm:text-4xl">{g.h1}</h1>
    <p class="mt-2 mb-6 max-w-2xl text-ink-soft">{g.intro}</p>

    <Calculator bundle={bundle} national={nationalArea} provenance={provenance} />

    <article class="mx-auto mt-14 max-w-2xl" aria-labelledby="guide-heading">
      <h2 id="guide-heading" class="text-3xl">{bundle.recipe.name} cost guide</h2>
      {
        g.review_status && (
          <p class="mt-4 rounded-xl border-2 border-orange bg-orange-50 px-4 py-3 text-sm font-bold">
            {g.review_status}: this guide is a draft and has not been fact-checked yet.
          </p>
        )
      }
      <p class="mt-4 text-ink-soft">{bundle.recipe.description}</p>
      <div class="prose-guide" set:html={guideTop} />
      <AdSlot name="midGuide" />
      <div class="prose-guide" set:html={guideBottom} />

      <section aria-labelledby="faq-heading" class="mt-10">
        <h2 id="faq-heading" class="text-2xl">Frequently asked questions</h2>
        <div class="mt-4 space-y-3">
          {
            g.faq.map((f) => (
              <details class="card p-4">
                <summary class="cursor-pointer font-bold">{f.q}</summary>
                <p class="mt-2 text-ink-soft">{f.a}</p>
              </details>
            ))
          }
        </div>
      </section>
    </article>

    <RelatedCalculators slugs={bundle.recipe.related} />
    <AdSlot name="end" />
  </div>
</Base>
