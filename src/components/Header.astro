---
import logo from '../assets/logo.svg?raw';
const path = Astro.url.pathname;
const nav = [
  { href: '/#calculators', label: 'Calculators' },
  { href: '/methodology/', label: 'How it works' },
  { href: '/about/', label: 'About' },
];
---

<header class="border-b border-line bg-paper/95">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href="/" class="block h-8 w-[138px] shrink-0 [&>svg]:h-8 [&>svg]:w-auto" aria-label="ZipCostly home" set:html={logo} />
    <nav aria-label="Main">
      <ul class="flex items-center gap-4 text-sm font-semibold sm:gap-6">
        {
          nav.map((item, i) => (
            <li class={i === 2 ? 'hidden sm:block' : ''}>
              <a href={item.href} class="text-ink no-underline hover:text-teal" aria-current={path === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
