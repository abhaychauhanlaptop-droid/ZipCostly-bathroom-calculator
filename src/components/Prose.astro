---
import Base from '../layouts/Base.astro';
interface Props {
  title: string;
  description: string;
  h1: string;
  needsReview?: boolean;
}
const { title, description, h1, needsReview = false } = Astro.props;
---

<Base title={title} description={description}>
  <article class="container-page max-w-2xl pt-10">
    <h1 class="text-3xl sm:text-4xl">{h1}</h1>
    {
      needsReview && (
        <p class="mt-4 rounded-xl border-2 border-orange bg-orange-50 px-4 py-3 text-sm font-bold">
          NEEDS HUMAN REVIEW: draft text, not yet reviewed.
        </p>
      )
    }
    <div class="prose-guide mt-6">
      <slot />
    </div>
  </article>
</Base>
